#!/usr/bin/env python3
# codex-git-plugin: prepare-commit-msg
"""Draft a Conventional Commit subject from staged file categories."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def staged_files() -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line]


def category(path: str) -> str:
    name = Path(path).name
    if path.startswith("docs/") or name.startswith(("README", "CHANGELOG", "LICENSE")) or name.endswith(".md"):
        return "docs"
    if "test" in name or "spec" in name or name.endswith(("_test.go", ".test.ts", ".test.tsx", ".spec.ts", ".spec.tsx")):
        return "test"
    if name in {".editorconfig", ".gitignore"} or name.startswith((".eslintrc", ".prettierrc")) or "config" in name:
        return "chore"
    if name.endswith((".css", ".scss", ".less")):
        return "style"
    return "feat"


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return 0
    message_file = Path(argv[1])
    source = argv[2] if len(argv) > 2 else ""
    if source:
        return 0

    files = staged_files()
    if not files:
        return 0

    categories = [category(path) for path in files]
    commit_type = categories[0] if all(item == categories[0] for item in categories) else "feat"

    lines = [
        f"{commit_type}: ",
        "",
        "# Draft generated by the Codex git plugin.",
        f"# Type detected: {commit_type}",
        f"# Files staged: {len(files)}",
    ]
    lines.extend(f"#   {path}" for path in files)
    lines.extend(
        [
            "#",
            "# Edit the first line. Lines starting with # are ignored.",
            "# Format: type: description",
            "# Valid types: feat | fix | docs | style | refactor | test | chore | perf",
        ]
    )
    message_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
