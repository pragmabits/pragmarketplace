{
  "description": "Codex git command safety hooks installed by the git commit workflow.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/git_command_policy.py\"",
            "timeout": 5,
            "statusMessage": "Checking git command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/git_command_policy.py\"",
            "timeout": 5,
            "statusMessage": "Checking git approval"
          }
        ]
      }
    ]
  }
}
