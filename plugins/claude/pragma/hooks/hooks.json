{
  "description": "Injects the standing working instruction as session context at startup, /clear and compaction, and runs the review gate on AskUserQuestion and on turn ends",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I ${CLAUDE_PLUGIN_ROOT}/gate/hook.py session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I ${CLAUDE_PLUGIN_ROOT}/gate/hook.py user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I ${CLAUDE_PLUGIN_ROOT}/gate/hook.py pre-tool-use",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -I ${CLAUDE_PLUGIN_ROOT}/gate/hook.py stop",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
