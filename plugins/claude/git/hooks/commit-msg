#!/bin/bash
set -euo pipefail

# commit-msg hook — validates commit messages against Conventional Commits format.
#   Subject (first line): type: description
#     - No scope (parentheses forbidden)
#     - Valid types: feat|fix|docs|style|refactor|test|chore|perf
#     - Description starts with a lowercase letter or digit
#     - Allowed chars in description: Unicode letters, digits, spaces, and , . / + - : ' # >
#     - Breaking change marker (!) allowed after type
#   Body (optional): separated from subject by a single blank line.
#     - Blocks C0/C1 control chars (except tab/LF/CR), bidi formatting, zero-width chars, and BOM
#       (CVE-2021-42574 / Trojan Source mitigation)
#
# Skips validation for git-generated messages (merge, revert, squash, cherry-pick,
# fixup!/squash!/amend!) — mirrors @commitlint/is-ignored defaultIgnores.

COMMIT_MSG_FILE="$1"

if [[ ! -f "$COMMIT_MSG_FILE" ]]; then
  echo "error: commit message file not found: $COMMIT_MSG_FILE" >&2
  exit 1
fi

# Read the commit message, stripping comment lines (lines starting with #)
message=$(sed '/^#/d' "$COMMIT_MSG_FILE")

if [[ -z "$message" ]]; then
  echo "error: commit message is empty" >&2
  exit 1
fi

# --- Skip validation for git-generated commit messages ---
# Primary detector: marker files that git creates during these operations.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo ".git")
if [[ -f "$GIT_DIR/MERGE_HEAD" ]] \
   || [[ -f "$GIT_DIR/SQUASH_MSG" ]] \
   || [[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]] \
   || [[ -f "$GIT_DIR/REVERT_HEAD" ]]; then
  exit 0
fi

# Fallback: textual prefixes (covers --amend after marker files are cleared).
subject_first_line=$(echo "$message" | head -1)
if [[ "$subject_first_line" =~ ^(Merge\ |Revert\ |fixup!|squash!|amend!) ]]; then
  exit 0
fi

# --- Valid types pattern ---
ALL_TYPES="feat|fix|docs|style|refactor|test|chore|perf"

# --- Extract subject line ---
subject=$(echo "$message" | head -1)

# --- Validate format: type(!?): description ---
if ! echo "$subject" | grep -qE "^($ALL_TYPES)!?: .+$"; then
  echo "error: commit message does not match the required format" >&2
  echo "  received: $subject" >&2
  echo "  expected: type: description" >&2
  echo "  valid types: $(echo "$ALL_TYPES" | tr '|' ', ')" >&2
  echo "  description must start with a lowercase letter or digit" >&2
  exit 1
fi

# --- Extract description (everything after "type(!?): ") ---
description=$(echo "$subject" | sed -E "s/^($ALL_TYPES)!?: //")

# --- Check description starts with a lowercase letter, digit, or caseless letter ---
# Unicode-aware: \p{Ll} = lowercase letter (ASCII + accented),
#                \p{N}  = any digit,
#                \p{Lo} = other letter (CJK, Hangul, etc. — no case distinction).
# Excludes \p{Lu} (uppercase) and \p{Lt} (titlecase).
if ! echo "$description" | grep -qP '^[\p{Ll}\p{N}\p{Lo}]'; then
  echo "error: description must start with a lowercase letter or digit" >&2
  echo "  received: $subject" >&2
  exit 1
fi

# --- Check allowed characters in description ---
# Allowed: Unicode letters, digits, spaces, and , . / + - : ' # >
# Note: bash regex handles ASCII; for full Unicode support we use grep -P
if echo "$description" | grep -qP "[^\p{L}\p{N} ,./+\-:'#>]"; then
  bad_char=$(echo "$description" | grep -oP "[^\p{L}\p{N} ,./+\-:'#>]" | head -1)
  echo "error: description contains disallowed character: '$bad_char'" >&2
  echo "  received: $subject" >&2
  echo "  allowed: Unicode letters, digits, spaces, and , . / + - : ' # >" >&2
  exit 1
fi

# --- Validate body separator if message is multi-line ---
line_count=$(echo "$message" | wc -l)
if [[ "$line_count" -gt 1 ]]; then
  second_line=$(echo "$message" | sed -n '2p')
  if [[ -n "$second_line" ]]; then
    echo "error: body must be separated from subject by a blank line" >&2
    echo "  received first body line: $second_line" >&2
    exit 1
  fi

  # --- Validate body characters (CVE-2021-42574 / Trojan Source mitigation) ---
  # Forbidden codepoints in the body:
  #   C0 controls (U+0000-U+001F) except tab (U+0009), LF (U+000A), CR (U+000D)
  #   DEL + C1 controls (U+007F-U+009F)
  #   Bidirectional formatting (U+202A-U+202E LRE/RLE/PDF/LRO/RLO,
  #                             U+2066-U+2069 LRI/RLI/FSI/PDI)
  #   Zero-width / invisible characters (U+200B-U+200F, U+2060-U+2064)
  #   Byte order mark (U+FEFF)
  body=$(echo "$message" | tail -n +3)
  if [[ -n "$body" ]]; then
    forbidden_body='[\x{0000}-\x{0008}\x{000B}\x{000C}\x{000E}-\x{001F}\x{007F}-\x{009F}\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{2066}-\x{2069}\x{FEFF}]'
    if echo "$body" | grep -qP "$forbidden_body"; then
      echo "error: body contains a disallowed control or bidirectional Unicode character" >&2
      echo "  blocked: C0/C1 controls (except tab/LF/CR), bidi formatting (RLO/LRO/PDF/PDI), zero-width chars, byte order mark" >&2
      echo "  reason: prevents Trojan Source-style spoofing (CVE-2021-42574) and invisible-character injection" >&2
      exit 1
    fi
  fi
fi

# All checks passed
exit 0
