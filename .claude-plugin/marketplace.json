  "plugins": [
    {
      "name": "git",
      "source": "./plugins/claude/git",
      "description": "Strategic git commit plugin — semantic analysis, whole-file staging, hook-validated commits, native git hooks, and safety hooks",
      "version": "3.0.1",
      "author": {
        "name": "pragmabits",
        "email": "leonardoleoncio96@gmail.com"
      },
      "homepage": "https://github.com/pragmabits/pragmarketplace",
      "repository": "https://github.com/pragmabits/pragmarketplace",
      "category": "tools",
      "commands": "./commands",
      "keywords": [
        "git",
        "commit",
        "version-control",
        "conventional-commits",
        "workflow",
        "automation",
        "strategic-commits",
        "validation"
      ]
    },
    {
