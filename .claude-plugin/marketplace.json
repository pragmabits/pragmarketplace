      "source": "./plugins/claude/frontend",
      "description": "Frontend development orchestrator — coordinates CSS, Tailwind CSS, Vue.js, Nuxt, shadcn/ui, Font Awesome, Material Design 3, HTMX + Go, and frontend design specialists for cross-domain frontend tasks",
      "version": "1.8.0",
      "author": {
        "name": "pragmabits",
        "email": "leonardoleoncio96@gmail.com"
      },
      "homepage": "https://github.com/pragmabits/pragmarketplace",
      "repository": "https://github.com/pragmabits/pragmarketplace",
      "category": "frontend",
      "commands": "./commands",
      "agents": [
        "./agents/frontend.md",
