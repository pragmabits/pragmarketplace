    {
      "name": "review",
      "source": "./plugins/claude/review",
      "description": "Independent Codex-based code review of the current git diff. Provides the /codex-review skill which runs codex-review.sh and presents the verdict, summary, and findings.",
      "version": "1.0.1",
      "author": {
        "name": "pragmabits",
        "email": "leonardoleoncio96@gmail.com"
      },
      "homepage": "https://github.com/pragmabits/pragmarketplace",
      "repository": "https://github.com/pragmabits/pragmarketplace",
      "category": "tools",
      "keywords": [
        "code-review",
        "codex",
        "git-diff",
        "review",
        "pre-commit",
        "second-opinion"
      ]
    },
    {
      "name": "session",
      "source": "./plugins/claude/session",
      "description": "Session lifecycle helpers for Claude Code. The /report skill writes a structured handoff report under .claude/sessions/ capturing the session contract, work completed, decisions, and fixed-numbered pending items. The /recall skill lists, filters, greps, and resumes prior reports so the next agent can pick up pending work without re-reading source code.",
      "version": "2.0.0",
      "author": {
        "name": "pragmabits",
        "email": "leonardoleoncio96@gmail.com"
      },
      "homepage": "https://github.com/pragmabits/pragmarketplace",
      "repository": "https://github.com/pragmabits/pragmarketplace",
      "category": "tools",
      "keywords": [
        "session",
        "report",
        "retrospective",
        "handoff",
        "summary",
        "workflow",
        "recall",
        "resume",
        "pending-items"
      ]
    },
    {
      "name": "pragmatic",
      "source": "./plugins/claude/pragmatic",
      "description": "Output style for pragmatic, evidence-driven engineering. Reserves material decisions (writes, behavior changes, strategy choices) for the user via AskUserQuestion, batches related decisions into one prompt, allows procedural autonomy (reads, searches, sandboxed runs), enforces evidence-backed claims, and keeps responses terse with in-line decision announcements.",
      "version": "1.0.1",
      "author": {
        "name": "pragmabits",
        "email": "leonardoleoncio96@gmail.com"
      },
      "homepage": "https://github.com/pragmabits/pragmarketplace",
      "repository": "https://github.com/pragmabits/pragmarketplace",
      "category": "output",
